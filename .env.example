# Copy to .env for LOCAL use only. Never commit real values.
# On Cloud Run, set secrets via Secret Manager references (see docs/DEPLOY_GCP.md).

# --- Apple Ads API credentials (Apple Ads → Account Settings → API, after uploading your public key) ---
APPLE_ADS_CLIENT_ID=SEARCHADS.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPLE_ADS_TEAM_ID=SEARCHADS.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPLE_ADS_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Exactly one of the two: PEM text (multi-line values are fine in Secret Manager;
# literal "\n" sequences are also accepted) or a file path.
APPLE_ADS_PRIVATE_KEY=
APPLE_ADS_PRIVATE_KEY_PATH=./private-key.pem

# --- Account isolation (mandatory) ---
# Comma-separated numeric ad account IDs (from GET /v1/acls or scripts/verify_credentials.py).
ALLOWED_ACCOUNT_IDS=123456789
# Optional if exactly one account is allowlisted.
DEFAULT_ACCOUNT_ID=
# Refuse to start if the API user holds a write-capable role (default: warn only).
APPLE_ADS_REQUIRE_READONLY_ROLE=false

# --- Transport ---
# stdio (local MCP clients) | http (Cloud Run)
MCP_TRANSPORT=stdio

# --- Remote auth (http transport only; modes are mutually exclusive) ---
# bearer (default, recommended) | secret_path (for MCP clients that cannot
# send custom headers, e.g. claude.ai custom connectors)
MCP_AUTH_MODE=bearer
# bearer mode:   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_ACCESS_TOKEN=
# secret_path mode (leave MCP_ACCESS_TOKEN empty):
MCP_PATH_SECRET=

# Optional ceilings (defaults 60 / 20; hard caps 500 / 50). Raise only for
# heavy analysis sessions — they protect your Apple rate limits from client loops.
# MAX_TOOL_CALLS_PER_HOUR=200
# MAX_SUBREQUESTS_PER_CALL=20
